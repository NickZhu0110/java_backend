{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 23,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "macos-homebrew-vtk-debug",
      "displayName": "macOS Homebrew Qt + VTK Debug",
      "description": "Use Homebrew Qt and Homebrew VTK. Do not mix with Qt Online Installer paths.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/homebrew-vtk-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_PREFIX_PATH": "/opt/homebrew;/opt/homebrew/opt/vtk",
        "VTK_DIR": "/opt/homebrew/lib/cmake/vtk-9.6",
        "Qt6_DIR": "/opt/homebrew/lib/cmake/Qt6",
        "QT_QMAKE_EXECUTABLE": "/opt/homebrew/bin/qmake6",
        "QT_CREATOR_ENABLE_MAINTENANCE_TOOL_PROVIDER": "OFF",
        "QT_CREATOR_ENABLE_PACKAGE_MANAGER_SETUP": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "macos-homebrew-vtk-debug-build",
      "displayName": "Build macOS Homebrew Qt + VTK Debug",
      "configurePreset": "macos-homebrew-vtk-debug",
      "jobs": 4
    }
  ]
}
